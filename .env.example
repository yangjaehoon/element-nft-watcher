# NFTScan API 키 (https://developer.nftscan.com 대시보드에서 즉시 발급) - 폴링(watcher.js)에 사용
NFTSCAN_API_KEY=

# Element OpenAPI 키 (https://forms.gle/78wpggURGADCjshr7 신청, 수동 심사) - stream-watcher.js 에만 사용
ELEMENT_API_KEY=

# ── 알림 채널 ── 설정한 것 모두로 전송된다. 하나도 없으면 콘솔 출력만.

# Telegram: @BotFather /newbot 으로 토큰 발급,
#           봇에 메시지 후 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TG_TOKEN=
TG_CHAT_ID=

# Discord: 채널 설정 > 연동 > 웹후크 > 새 웹후크 URL 복사
DISCORD_WEBHOOK_URL=

# Slack: https://api.slack.com/messaging/webhooks 에서 Incoming Webhook URL 생성
SLACK_WEBHOOK_URL=

# ntfy: 앱 설치 후 임의 토픽 구독. 아래에 같은 토픽명 입력 (공개 서버는 토픽명이 곧 비밀번호)
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Pushover: https://pushover.net 앱 등록 후 API Token 과 User Key
PUSHOVER_TOKEN=
PUSHOVER_USER=

# 범용 Webhook: { "text": "..." } 형태로 POST (n8n, 자체 서버 등)
WEBHOOK_URL=
