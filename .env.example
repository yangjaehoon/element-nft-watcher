# API 키 불필요 — watcher.js 는 헤드리스 브라우저로 element.market 을 직접 조회한다.
# 아래는 알림 채널만 있으면 된다. 설정한 것 모두로 전송된다. 하나도 없으면 콘솔 출력만.

# Discord: 채널 설정 > 연동 > 웹후크 > 새 웹후크 URL 복사
DISCORD_WEBHOOK_URL=

# Telegram: @BotFather /newbot 으로 토큰 발급,
#           봇에 메시지 후 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TG_TOKEN=
TG_CHAT_ID=

# Slack: https://api.slack.com/messaging/webhooks 에서 Incoming Webhook URL 생성
SLACK_WEBHOOK_URL=

# ntfy: 앱 설치 후 임의 토픽 구독. 아래에 같은 토픽명 입력 (공개 서버는 토픽명이 곧 비밀번호)
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Pushover: https://pushover.net 앱 등록 후 API Token 과 User Key
PUSHOVER_TOKEN=
PUSHOVER_USER=

# 범용 Webhook: { "text": "..." } 형태로 POST (n8n, 자체 서버 등)
WEBHOOK_URL=

# ── 선택 사항 ──

# Element 공식 API 키 (https://forms.gle/78wpggURGADCjshr7 신청, 수동 심사)
# stream-watcher.js 에서만 사용. watcher.js/check-floors.js 는 필요 없음.
ELEMENT_API_KEY=
